<?xml version="1.0" encoding="utf-8"?>
<!--
  Prefer SurfaceView for hardware-decoded camera video. Pixel/Exynos HEVC can lose
  the TextureView BufferQueue while RTSP attempts are replaced, leaving the codec
  with "no connected producer". Snapshot/recording code uses PixelCopy for this
  surface type.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="surface_view"
    app:use_controller="false" />
